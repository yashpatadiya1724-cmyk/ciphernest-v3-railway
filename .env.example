# CipherNest Environment Configuration Template
# Copy this file to .env and configure local values

PORT=5000
NODE_ENV=development

# Database (MongoDB connection string)
MONGODB_URI=mongodb://localhost:27017/ciphernest

# Vault & Authentication Security Key
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# AI Threat Advisory Providers (Gemini or Groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
